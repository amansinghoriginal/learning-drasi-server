# Example environment variables for the building-comfort tutorial
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env with real credentials!
# Literal NAME=value entries only. Exported environment variables take precedence.

# Local containers; set docker explicitly in a Docker-based dev container.
CONTAINER_ENGINE=podman
COMPOSE_PROJECT_NAME=building-comfort-cg

# Database and query indexes from the older tutorial are not reused.
# Change both port values together if 5732 is already occupied.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5732
POSTGRES_HOST_PORT=5732

# Drasi Server settings.
SERVER_HOST=127.0.0.1
SERVER_PORT=8380
LOG_LEVEL=info

# Dashboard reaction settings.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000

# Optional absolute paths (defaults use the existing sibling Server checkout).
# DRASI_SERVER_REPO=/path/to/drasi-server
# CARGO_TARGET_DIR=/path/to/drasi-server/target
# DRASI_DEMO_DIR=/path/to/private-building-comfort-run
