# Example environment variables for the otel-observability tutorial
#
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env with real credentials!

# PostgreSQL connection settings.
POSTGRES_HOST=localhost
POSTGRES_PORT=5732
POSTGRES_HOST_PORT=5732
POSTGRES_DATABASE=otel_observability
POSTGRES_USER=drasi_user
POSTGRES_PASSWORD=drasi_password

# Kubernetes (k3d) settings.
K3D_CLUSTER_NAME=otel-observability
K3D_API_PORT=6551
# Host port forwarded to the checkout control API (NodePort 30080).
CHECKOUT_CONTROL_PORT=18080

# Drasi Server settings.
SERVER_HOST=0.0.0.0
SERVER_PORT=8380
LOG_LEVEL=info

# Dashboard reaction settings.
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000

# OTel source listen address (Collector in the cluster exports here).
OTEL_GRPC_BIND=0.0.0.0:14317
